{
  "name": "@complyee/mcp-guard",
  "version": "0.1.0",
  "description": "Customer-run policy guard for MCP tool servers: runs a tool only on a verified Agent Control Room grant for exactly that call.",
  "license": "Apache-2.0",
  "author": "Complyee AB",
  "homepage": "https://agent-cr.com/plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/complyee/mcp-guard.git"
  },
  "bugs": {
    "url": "https://github.com/complyee/mcp-guard/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "policy",
    "authorization",
    "jwt",
    "jwks",
    "agent-control-room",
    "complyee"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
